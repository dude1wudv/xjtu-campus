            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/widget_lesson6" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#26364F" android:maxLines="4" android:ellipsize="end" />
                <TextView android:id="@+id/widget_task6" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#7852B6" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="8dp" android:background="#D5DFEE" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="6dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_attendance" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_attendance" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#33445E" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="6dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_task" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_homework" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#7852B6" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="6dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_card" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_card" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#007AFF" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:paddingTop="6dp">
        <ImageView android:layout_width="16dp" android:layout_height="16dp" android:src="@drawable/widget_seat" android:importantForAccessibility="no" />
        <TextView android:id="@+id/widget_seat" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textColor="#26876B" android:maxLines="1" android:ellipsize="end" />
    </LinearLayout>
    <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="9sp" android:textColor="#7E8795" android:paddingTop="8dp" android:maxLines="1" android:ellipsize="end" />
</LinearLayout>
