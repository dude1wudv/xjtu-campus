                <TextView android:id="@+id/widget_task2" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#7852B6" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#DDE5F0" />
