<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="14dp" android:background="@drawable/widget_glass">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
        <ImageView android:layout_width="24dp" android:layout_height="24dp" android:src="@drawable/widget_calendar" android:contentDescription="周日历" />
        <TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="18sp" android:textStyle="bold" android:textColor="#172744" />
    </LinearLayout>
    <TextView android:id="@+id/widget_week" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#6E7583" android:paddingTop="4dp" android:paddingBottom="8dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:id="@+id/widget_day0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <LinearLayout android:id="@+id/widget_date_box0" android:layout_width="44dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_date">
                <TextView android:id="@+id/widget_weekday0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#6E7583" />
                <TextView android:id="@+id/widget_date0" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="#26364F" />
            </LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/widget_lesson0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#26364F" android:maxLines="4" android:ellipsize="end" />
                <TextView android:id="@+id/widget_task0" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#7852B6" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#DDE5F0" />
        <LinearLayout android:id="@+id/widget_day1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <LinearLayout android:id="@+id/widget_date_box1" android:layout_width="44dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_date">
                <TextView android:id="@+id/widget_weekday1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#6E7583" />
                <TextView android:id="@+id/widget_date1" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="13sp" android:textStyle="bold" android:textColor="#26364F" />
