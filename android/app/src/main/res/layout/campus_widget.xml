            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="10dp">
                <TextView android:id="@+id/widget_lesson1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="11sp" android:textColor="#26364F" android:maxLines="4" android:ellipsize="end" />
                <TextView android:id="@+id/widget_task1" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#7852B6" android:maxLines="1" android:ellipsize="end" />
            </LinearLayout>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginStart="54dp" android:background="#DDE5F0" />
        <LinearLayout android:id="@+id/widget_day2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="3dp" android:paddingBottom="3dp">
            <LinearLayout android:id="@+id/widget_date_box2" android:layout_width="44dp" android:layout_height="match_parent" android:orientation="vertical" android:gravity="center" android:background="@drawable/widget_date">
